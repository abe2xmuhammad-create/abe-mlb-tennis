# Copy to .env and fill in only what you use. `.env` is gitignored — never
# commit real keys. Every variable here is read directly from the environment;
# this file is documentation, and the code does not load it for you.
#
#   set -a; source .env; set +a

# ---------------------------------------------------------------------------
# Provider selection
# ---------------------------------------------------------------------------
# ollama | gemini | deepseek | anthropic | openai.  Default: ollama
LLM_PROVIDER=ollama

# ---------------------------------------------------------------------------
# Local (default) — free, no API key.  Requires `ollama serve`.
# ---------------------------------------------------------------------------
OLLAMA_MODEL=qwen3.5:4b
OLLAMA_BASE_URL=http://localhost:11434
# Reasoning models spend their budget in a separate "thinking" field and can
# leave the answer empty. Leave unset to disable thinking for short notes.
# OLLAMA_THINK=
OLLAMA_TIMEOUT=300

# ---------------------------------------------------------------------------
# Hosted providers — set the key for the one you use.
# ---------------------------------------------------------------------------
# gemini-2.0-flash was shut down by Google on 2026-06-01 and now returns 404.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
ANTHROPIC_MAX_TOKENS=1024

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
# Any OpenAI-compatible endpoint: OpenRouter, Groq, vLLM, llama.cpp, ...
# A loopback URL does not require OPENAI_API_KEY.
OPENAI_BASE_URL=https://api.openai.com/v1

# ---------------------------------------------------------------------------
# Request policy (shared)
# ---------------------------------------------------------------------------
# Per-provider timeout, in seconds. <PROVIDER>_TIMEOUT wins over LLM_TIMEOUT.
# OLLAMA_TIMEOUT / GEMINI_TIMEOUT / DEEPSEEK_TIMEOUT / ANTHROPIC_TIMEOUT / OPENAI_TIMEOUT
# LLM_TIMEOUT=60
LLM_MAX_RETRIES=3
LLM_BACKOFF=0.5

# ---------------------------------------------------------------------------
# Analysis
# ---------------------------------------------------------------------------
# Concurrent game analyses. Each game is an independent request, so this is
# bounded by the provider's rate limit, not by CPU.
RAG_WORKERS=4
